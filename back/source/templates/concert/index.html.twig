{% extends 'base.html.twig' %}

{% block title %}Concert index{% endblock %}

{% block body %}

 <div class="container-fluid px-4">
    <h1>Concert</h1>

    <table class="table">
        <thead>
            <tr>
             <th>Nom du groupe</th>
                <th>DateConcert</th>
                <th>Prix</th>
                <th>Nombre de place</th>
               
             </tr>
        </thead>
        <tbody>
        {% for concert in concerts %}
            <tr>
              <td>{{ concert.name }}</td>
                <td>{{ concert.dateConcert ? concert.dateConcert|date('Y-m-d H:i:s') : '' }}</td>
                 <td>{{ concert.prix }}</td>
                <td>{{ concert.numberOfPlace }}</td>
              
                <td>
                    <a href="{{ path('app_concert_show', {'id': concert.id}) }}">show</a>
                    <a href="{{ path('app_concert_edit', {'id': concert.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_concert_new') }}">Create new</a>

    </div>
{% endblock %}
