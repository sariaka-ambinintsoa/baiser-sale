{% extends 'base.html.twig' %}

{% block title %}Concert{% endblock %}

{% block body %}

   <div class="container-fluid px-4">

    <h1>Concert</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ concert.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ concert.name }}</td>
            </tr>

            <tr>
                <th>Descriptions</th>
                <td>{{ concert.descriptions }}</td>
            </tr>
            <tr>
                <th>DateConcert</th>
                <td>{{ concert.dateConcert ? concert.dateConcert|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Pictures</th>
                <td>{{ concert.pictures }}</td>
            </tr>
            <tr>
                <th>Tag</th>
                <td>{{ concert.tag }}</td>
            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ concert.prix }}</td>
            </tr>
            <tr>
                <th>NumberOfPlace</th>
                <td>{{ concert.numberOfPlace }}</td>
            </tr>
           
        </tbody>
    </table>

    <a href="{{ path('app_concert_index') }}">back to list</a>

    <a href="{{ path('app_concert_edit', {'id': concert.id}) }}">edit</a>

    {{ include('concert/_delete_form.html.twig') }}
    </div>     
{% endblock %}
